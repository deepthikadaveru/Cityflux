# -------------------------
__pycache__/
*.py[cod]
*.pyo
*.pyd

.venv/
venv/
env/
ENV/

.pytest_cache/
.mypy_cache/
.ruff_cache/
.pyright/
*.egg-info/

# Python build artifacts
build/
dist/
wheels/

# -------------------------
# Environment / Secrets
# -------------------------
.env
.env.*
!.env.example

*.pem
*.key
*.crt
*.p12
*.pfx

# -------------------------
# Node / React / Vite
# -------------------------
node_modules/
**/node_modules/

frontend/dist/
frontend/build/
.vite/

npm-debug.log*
yarn-debug.log*
pnpm-debug.log*

package-lock.json
yarn.lock
pnpm-lock.yaml

# -------------------------
# IDE / Editor
# -------------------------
.vscode/
.idea/
*.swp
*.swo

# -------------------------
# Operating System
# -------------------------
.DS_Store
Thumbs.db
desktop.ini

# -------------------------
# Logs
# -------------------------
*.log
logs/

